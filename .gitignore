.netlify/

# ---- Local-only working files ----
# Pre-rebuild copies of index.html and style.css. Kept on disk only:
# git history is the real backup now, so this folder can be deleted
# once you are happy with the new site.
.backup/

# Scratch files from local testing (audits, screenshots, previews).
_*.html
_*.js
*.png.bak

# ---- Original full-size image masters ----
